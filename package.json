{
  "name": "brief",
  "displayName": "Brief",
  "description": "Prime Agent in VS Code, as the Brief POC 1 runtime shell.",
  "version": "0.2.4",
  "publisher": "litechenacc",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "prime agent",
    "prime intellect",
    "ai agent",
    "coding agent",
    "chat",
    "rlm",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/litechenacc/brief"
  },
  "homepage": "https://github.com/litechenacc/brief",
  "bugs": "https://github.com/litechenacc/brief/issues",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Launches a local agent process that reads and writes files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prime-agent",
          "title": "Brief",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "prime-agent": [
        {
          "id": "primeAgent.chat",
          "type": "webview",
          "name": "Brief"
        }
      ]
    },
    "commands": [
      {
        "command": "primeAgent.openChat",
        "title": "Open Chat in Editor Tab",
        "icon": "$(comment-discussion)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.focusChat",
        "title": "Focus Chat",
        "icon": "$(comment-discussion)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.newSession",
        "title": "New Session",
        "icon": "$(add)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.abort",
        "title": "Stop Agent",
        "icon": "$(debug-stop)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.compact",
        "title": "Compact Context",
        "icon": "$(fold)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.installAgentExtension",
        "title": "Install Background Jobs Agent Extension\u2026",
        "icon": "$(cloud-download)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.exportChat",
        "title": "Export Chat\u2026",
        "icon": "$(export)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.history",
        "title": "Sessions in this workspace",
        "icon": "$(history)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.renameSession",
        "title": "Rename Session",
        "icon": "$(edit)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.openPrimeIntellect",
        "title": "Visit Prime Intellect",
        "icon": "$(link-external)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.restart",
        "title": "Restart Agent Process",
        "icon": "$(debug-restart)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.addSelectionToChat",
        "title": "Add Selection to Chat",
        "icon": "$(symbol-snippet)",
        "category": "Brief"
      },
      {
        "command": "primeAgent.addActiveFileToChat",
        "title": "Add Active File to Chat",
        "icon": "$(file)",
        "category": "Brief"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "primeAgent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "9_primeagent@1"
        },
        {
          "command": "primeAgent.addActiveFileToChat",
          "when": "!editorHasSelection",
          "group": "9_primeagent@2"
        }
      ],
      "view/title": [
        {
          "command": "primeAgent.newSession",
          "when": "view == primeAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "primeAgent.history",
          "when": "view == primeAgent.chat",
          "group": "navigation@2"
        },
        {
          "command": "primeAgent.renameSession",
          "when": "view == primeAgent.chat",
          "group": "navigation@3"
        },
        {
          "command": "primeAgent.compact",
          "when": "view == primeAgent.chat",
          "group": "1_session@2"
        },
        {
          "command": "primeAgent.exportChat",
          "when": "view == primeAgent.chat",
          "group": "1_session@3"
        },
        {
          "command": "primeAgent.restart",
          "when": "view == primeAgent.chat",
          "group": "1_session@4"
        },
        {
          "command": "primeAgent.openPrimeIntellect",
          "when": "view == primeAgent.chat",
          "group": "2_links@1"
        }
      ],
      "editor/title": [
        {
          "command": "primeAgent.focusChat",
          "when": "editorTextFocus",
          "group": "navigation@99"
        },
        {
          "command": "primeAgent.newSession",
          "when": "activeWebviewPanelId == 'primeAgent.chatPanel'",
          "group": "navigation@1"
        },
        {
          "command": "primeAgent.history",
          "when": "activeWebviewPanelId == 'primeAgent.chatPanel'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "primeAgent.addSelectionToChat",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "primeAgent.focusChat",
        "key": "ctrl+alt+meta+p",
        "mac": "ctrl+alt+cmd+p"
      },
      {
        "command": "primeAgent.addSelectionToChat",
        "key": "alt+cmd+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Prime Agent",
      "properties": {
        "primeAgent.command": {
          "type": "string",
          "default": "prime-agent",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Command used to start the Prime Agent CLI. Set to an absolute path (e.g. /path/to/prime-agent.sh) when prime-agent is not on PATH."
        },
        "primeAgent.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "ignoreSync": true,
          "description": "Extra CLI arguments appended after `--mode rpc` (e.g. [\"--provider\", \"chutes\"])."
        },
        "primeAgent.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Model passed as --model when the agent starts (provider/id pattern). Empty uses the default model."
        },
        "primeAgent.maxFileSearchResults": {
          "type": "number",
          "default": 40,
          "description": "Maximum results returned for @ file mention search."
        },
        "primeAgent.sendSelectionSnippet": {
          "type": "boolean",
          "default": true,
          "description": "Include the selected code as context when using 'Add Selection to Chat'."
        },
        "primeAgent.defaultStreamingBehavior": {
          "type": "string",
          "enum": [
            "steer",
            "followUp"
          ],
          "default": "steer",
          "description": "How messages sent while the agent is working are delivered: steer interrupts after the current turn, followUp waits until the run ends. Toggleable per-run in the chat rail."
        },
        "primeAgent.liveTranscript": {
          "type": "boolean",
          "default": false,
          "description": "Paint thinking and tool-call arguments as they stream. Off (default) keeps unfinished parts behind the working row until thinking settles, a tool starts running, or reply text appears."
        },
        "primeAgent.streamToolOutput": {
          "type": "boolean",
          "default": false,
          "description": "Paint tool output as it arrives. Off (default) waits until the tool finishes. Independent of liveTranscript."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.config.mjs --production && npx @vscode/vsce package --no-dependencies",
    "smoke": "node test/smoke.mjs",
    "test": "node test/agent-locator.test.mjs && node test/activate.test.mjs && node test/chat-view-message.test.mjs && node test/session-controller-boundary.test.mjs && node test/attach-lifecycle.test.mjs && node test/session-actions.test.mjs && node test/webview.test.mjs && node test/transcript-window.test.mjs && node test/thread-diffs.test.mjs && node test/processes.test.mjs && node test/background-task-tracker.test.mjs && node test/agent-jobs.test.mjs && node test/background-jobs.test.mjs && node test/export-md.test.mjs && node test/recent-sessions-tail.test.mjs && node test/roster-parity.test.mjs && node test/crosswire.test.mjs && node test/image-fit.test.mjs && node test/transport-regression.test.mjs && node test/owner-visibility.test.mjs",
    "test:live": "node esbuild.config.mjs && node test/extension-load.mjs && node test/daemon-parity.mjs --require-daemon && node test/owned-roster.mjs --require-daemon && node test/host-e2e.mjs && node test/smoke.mjs",
    "test:e2e": "node test/vscode-e2e.mjs",
    "test:shots": "node test/preview-shot.mjs",
    "driver": "node test/live-driver.mjs",
    "icon": "node test/render-icon.cjs",
    "pretest": "node esbuild.config.mjs",
    "presmoke": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  }
}

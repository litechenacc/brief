{
  "name": "brief",
  "displayName": "Brief",
  "description": "Brief is a persistent AI coding agent for VS Code.",
  "version": "0.3.0",
  "publisher": "litechenacc",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "ai agent",
    "coding agent",
    "chat",
    "rlm",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/litechenacc/brief"
  },
  "homepage": "https://github.com/litechenacc/brief",
  "bugs": "https://github.com/litechenacc/brief/issues",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Launches a local agent process that reads and writes files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:brief.chatPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "brief.openChat",
        "title": "Open Chat in Editor Tab",
        "icon": { "light": "media/tab-light.svg", "dark": "media/tab-dark.svg" },
        "category": "Brief"
      },
      {
        "command": "brief.focusChat",
        "title": "Focus Chat",
        "icon": { "light": "media/tab-light.svg", "dark": "media/tab-dark.svg" },
        "category": "Brief"
      },
      {
        "command": "brief.newSession",
        "title": "New Session",
        "icon": "$(add)",
        "category": "Brief"
      },
      {
        "command": "brief.abort",
        "title": "Stop Agent",
        "icon": "$(debug-stop)",
        "category": "Brief"
      },
      {
        "command": "brief.compact",
        "title": "Compact Context",
        "icon": "$(fold)",
        "category": "Brief"
      },
      {
        "command": "brief.exportChat",
        "title": "Export Chat\u2026",
        "icon": "$(export)",
        "category": "Brief"
      },
      {
        "command": "brief.history",
        "title": "Sessions in this workspace",
        "icon": "$(history)",
        "category": "Brief"
      },
      {
        "command": "brief.renameSession",
        "title": "Rename Session",
        "icon": "$(edit)",
        "category": "Brief"
      },
      {
        "command": "brief.restart",
        "title": "Restart Agent Process",
        "icon": "$(debug-restart)",
        "category": "Brief"
      },
      {
        "command": "brief.addSelectionToChat",
        "title": "Add Selection to Chat",
        "icon": "$(symbol-snippet)",
        "category": "Brief"
      },
      {
        "command": "brief.addActiveFileToChat",
        "title": "Add Active File to Chat",
        "icon": "$(file)",
        "category": "Brief"
      },
      {
        "command": "brief.useEditor",
        "title": "Use Editor",
        "category": "Brief",
        "icon": "$(open-preview)"
      },
      {
        "command": "brief.useSidebar",
        "title": "Use Sidebar",
        "category": "Brief",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "brief.toggleChatLocation",
        "title": "Toggle Chat Location",
        "category": "Brief",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "brief.switchSession",
        "title": "Switch Session",
        "category": "Brief",
        "icon": "$(list-selection)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "brief.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "9_brief@1"
        },
        {
          "command": "brief.addActiveFileToChat",
          "when": "!editorHasSelection",
          "group": "9_brief@2"
        }
      ],
      "editor/title": [
        {
          "command": "brief.focusChat",
          "when": "editorTextFocus",
          "group": "navigation@99"
        },
        {
          "command": "brief.newSession",
          "when": "activeWebviewPanelId == 'brief.chatPanel'",
          "group": "navigation@1"
        },
        {
          "command": "brief.renameSession",
          "when": "activeWebviewPanelId == 'brief.chatPanel'",
          "group": "navigation@3"
        },
        {
          "command": "brief.compact",
          "when": "activeWebviewPanelId == 'brief.chatPanel'",
          "group": "1_session@2"
        },
        {
          "command": "brief.exportChat",
          "when": "activeWebviewPanelId == 'brief.chatPanel'",
          "group": "1_session@3"
        },
        {
          "command": "brief.restart",
          "when": "activeWebviewPanelId == 'brief.chatPanel'",
          "group": "1_session@4"
        }
      ],
      "commandPalette": [
        {
          "command": "brief.addSelectionToChat",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "brief.newSession",
          "when": "view == brief.chat",
          "group": "navigation@1"
        },
        {
          "command": "brief.switchSession",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "navigation@2"
        },
        {
          "command": "brief.history",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "navigation@3"
        },
        {
          "command": "brief.renameSession",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "1_session@1"
        },
        {
          "command": "brief.compact",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "1_session@2"
        },
        {
          "command": "brief.exportChat",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "1_session@3"
        },
        {
          "command": "brief.restart",
          "when": "view == brief.chat && config.brief.chatLocation == sidebar",
          "group": "1_session@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "brief.focusChat",
        "key": "ctrl+alt+meta+p",
        "mac": "ctrl+alt+cmd+p"
      },
      {
        "command": "brief.addSelectionToChat",
        "key": "alt+cmd+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Brief",
      "properties": {
        "brief.command": {
          "type": "string",
          "default": "prime-agent",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Command used to start Brief's agent runtime. Set an absolute path when `prime-agent` is not on PATH."
        },
        "brief.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "ignoreSync": true,
          "description": "Extra CLI arguments appended after `--mode rpc` (e.g. [\"--provider\", \"chutes\"])."
        },
        "brief.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "ignoreSync": true,
          "description": "Model passed as --model when the agent starts (provider/id pattern). Empty uses the default model."
        },
        "brief.maxFileSearchResults": {
          "type": "number",
          "default": 40,
          "description": "Maximum results returned for @ file mention search."
        },
        "brief.sendSelectionSnippet": {
          "type": "boolean",
          "default": true,
          "description": "Include the selected code as context when using 'Add Selection to Chat'."
        },
        "brief.defaultStreamingBehavior": {
          "type": "string",
          "enum": [
            "steer",
            "followUp"
          ],
          "default": "steer",
          "description": "How messages sent while the agent is working are delivered: steer interrupts after the current turn, followUp waits until the run ends. Toggleable per-run in the chat rail."
        },
        "brief.liveTranscript": {
          "type": "boolean",
          "default": false,
          "description": "Paint thinking and tool-call arguments as they stream. Off (default) keeps unfinished parts behind the working row until thinking settles, a tool starts running, or reply text appears."
        },
        "brief.showThoughtProcess": {
          "type": "boolean",
          "default": false,
          "description": "Show the Thought process block on replies (hidden by default). Display only; does not change the model thinking level."
        },
        "brief.showUsageDetails": {
          "type": "boolean",
          "default": false,
          "description": "Show the usage-details entry on each reply (off by default). Does not affect error messages, the copy button, or session cost."
        },
        "brief.streamToolOutput": {
          "type": "boolean",
          "default": false,
          "description": "Paint tool output as it arrives. Off (default) waits until the tool finishes. Independent of liveTranscript."
        },
        "brief.chatLocation": {
          "type": "string",
          "enum": [
            "editor",
            "sidebar"
          ],
          "default": "editor",
          "scope": "window",
          "description": "Default location for new sessions and Focus Chat. Use Brief: Use Editor or Use Sidebar to also move the current session."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brief",
          "title": "Brief",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "brief": [
        {
          "id": "brief.chat",
          "type": "webview",
          "name": "Brief"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.config.mjs --production && npx @vscode/vsce package --no-dependencies",
    "smoke": "node test/smoke.mjs",
    "test": "node test/agent-locator.test.mjs && node test/activate.test.mjs && node test/editor-tabs.test.mjs && node test/session-startup.test.mjs && node test/chat-view-message.test.mjs && node test/session-controller-boundary.test.mjs && node test/attach-lifecycle.test.mjs && node test/session-actions.test.mjs && node test/webview.test.mjs && node test/view-state.test.mjs && node test/transcript-window.test.mjs && node test/export-md.test.mjs && node test/recent-sessions-tail.test.mjs && node test/roster-parity.test.mjs && node test/crosswire.test.mjs && node test/image-fit.test.mjs && node test/transport-regression.test.mjs && node test/owner-visibility.test.mjs && node test/hidden-details.test.mjs && node test/working-animation.test.mjs",
    "test:live": "node esbuild.config.mjs && node test/daemon-parity.mjs --require-daemon && node test/owned-roster.mjs --require-daemon && node test/host-e2e.mjs && node test/smoke.mjs",
    "icon": "node test/render-icon.cjs",
    "pretest": "node esbuild.config.mjs",
    "presmoke": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  }
}

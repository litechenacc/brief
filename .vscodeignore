.vscode/**
.vscode-test/**
src/**
webview/**
test/**
node_modules/**
esbuild.config.mjs
tsconfig.json
.gitignore
*.vsix

# Unredacted screenshot inputs at the repository root; publish media/screenshots instead.
image.png
*.map
media/*.map

# Keep local secrets and maintainer scripts out of distributable packages.
.env
.env.*
release.sh
install.sh

dist/*.map
dist/*.cjs

# Knowledge-graph output. Gitignored, which is exactly why it needs a line here:
# vsce globs with dot:true and never reads .gitignore, so being invisible to git
# is what let 4 MB of symbol map — naming the very files this file excludes —
# into the locally packaged vsix.
graphify-out/**

# Repo-level product docs live next to the extension after flattening vscode/.
docs/**
prd.md
issues.md
snapshots.md
justfile
AGENTS.md
scripts/**
